{
  "name": "Back to Me API",
  "services": [
    {
      "name": "api",
      "source": {
        "repo": "https://github.com/janotaadm-creator/back-to-me"
      },
      "domains": [
        "back-to-me-api.railway.app"
      ],
      "config": {
        "PORT": 3000,
        "NODE_ENV": "production",
        "DATABASE_URL": "${{DATABASE_URL}}",
        "STRIPE_SECRET_KEY": "${{STRIPE_SECRET_KEY}}",
        "STRIPE_WEBHOOK_SECRET": "${{STRIPE_WEBHOOK_SECRET}}",
        "JWT_SECRET": "${{JWT_SECRET}}",
        "FRONTEND_URL": "https://back-to-me-landing.pages.dev"
      }
    },
    {
      "name": "postgres",
      "source": {
        "image": "postgres:15"
      },
      "environment": [
        "POSTGRES_DB=back_to_me",
        "POSTGRES_USER=postgres",
        "POSTGRES_PASSWORD=${{POSTGRES_PASSWORD}}"
      ]
    }
  ]
}